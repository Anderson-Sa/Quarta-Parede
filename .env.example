# Caminho do banco SQLite local
DATABASE_URL="file:./dev.db"

# Login e senha do primeiro admin, usados apenas para criar a conta inicial
# (tabela AdminUser) na primeira vez que alguém logar em /admin/login. Depois
# disso essas variáveis não são mais lidas — cada pessoa tem sua própria
# conta, gerenciada em /admin/usuarios.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Chave usada para assinar o cookie de sessão do admin (openssl rand -hex 32)
ADMIN_SESSION_SECRET=""

# URL pública do site (usada em sitemap, RSS e metatags Open Graph)
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com"

# Opcional: envio de digest da newsletter via Resend (https://resend.com).
# Sem essas duas variáveis, o botão "Enviar digest" fica desabilitado.
RESEND_API_KEY=""
NEWSLETTER_FROM_EMAIL=""

# Opcional: notifica este e-mail via Resend sempre que um novo comentário for
# enviado no site (requer RESEND_API_KEY e NEWSLETTER_FROM_EMAIL acima).
# Sem essa variável, a notificação simplesmente não é enviada.
COMMENT_NOTIFICATION_EMAIL=""

# Opcional: token que autoriza o envio automático do digest da newsletter via
# GET /api/cron/newsletter-digest (openssl rand -hex 32). Configurado como
# cron semanal no vercel.json, que já envia esse token automaticamente no
# header Authorization. Sem essa variável, o endpoint recusa qualquer
# chamada — o envio manual pelo botão em /admin/assinantes continua
# funcionando normalmente.
CRON_SECRET=""

# Opcional: CAPTCHA do Cloudflare Turnstile (https://developers.cloudflare.com/turnstile/)
# no formulário de comentário, além do honeypot e do rate limit já existentes.
# Sem TURNSTILE_SECRET_KEY, o widget não é exibido e a verificação é
# simplesmente pulada. As duas chaves vêm do mesmo "site" cadastrado no
# painel do Turnstile.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
