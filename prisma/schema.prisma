// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SiteSettings {
  id         String   @id @default(cuid())
  siteName   String   @default("Quarta Parede")
  slogan     String   @default("Notícias e novidades do universo geek.")
  logoUrl    String?
  footerText String   @default("Quarta Parede — notícias do universo geek: cinema, animes, séries e games.")
  updatedAt  DateTime @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  excerpt       String
  content       String
  coverImageUrl String?
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  published     Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
