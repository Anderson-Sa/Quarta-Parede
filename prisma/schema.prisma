// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SiteSettings {
  id               String   @id @default(cuid())
  siteName         String   @default("Quarta Parede")
  slogan           String   @default("Notícias e novidades do universo geek.")
  logoUrl          String?
  footerText       String   @default("Quarta Parede — notícias do universo geek: cinema, animes, séries e games.")
  brandColor       String   @default("#8b5cf6")
  accentColor      String   @default("#22d3ee")
  fontFamily       String   @default("geist")
  // JSON-encoded array of { id: "destaques" | "outros" | "ultimas", visible: boolean },
  // in display order. See src/lib/siteSettings.ts#parseHomeSections.
  homeSectionOrder String   @default("[{\"id\":\"destaques\",\"visible\":true},{\"id\":\"outros\",\"visible\":true},{\"id\":\"ultimas\",\"visible\":true}]")
  // One of the DESTAQUES_LAYOUT_VALUES in src/lib/homeSections.ts.
  destaquesLayout  String   @default("grid")
  updatedAt        DateTime @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  coverImageUrl  String?
  coverImageAlt  String?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  tags           Tag[]
  comments       Comment[]
  revisions      PostRevision[]
  views          Int       @default(0)
  published      Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Comment {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  body        String
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
}

model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  excerpt   String
  content   String
  createdAt DateTime @default(now())

  @@index([postId])
}
