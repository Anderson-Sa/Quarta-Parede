// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model SiteSettings {
  id               String   @id @default(cuid())
  siteName         String   @default("Quarta Parede")
  slogan           String   @default("Notícias e novidades do universo geek.")
  logoUrl          String?
  footerText       String   @default("Quarta Parede — notícias do universo geek: cinema, animes, séries e games.")
  // Rendered on the public "Sobre nós" page (src/app/(site)/sobre/page.tsx).
  aboutText        String   @default("Somos apaixonados por cultura geek: cinema, animes, séries e games. Este espaço nasceu para compartilhar notícias, análises e tudo que move essas comunidades.")
  brandColor       String   @default("#8b5cf6")
  accentColor      String   @default("#22d3ee")
  fontFamily       String   @default("geist")
  // JSON-encoded array of { id: "destaques" | "outros" | "ultimas", visible: boolean },
  // in display order. See src/lib/siteSettings.ts#parseHomeSections.
  homeSectionOrder String   @default("[{\"id\":\"destaques\",\"visible\":true},{\"id\":\"outros\",\"visible\":true},{\"id\":\"ultimas\",\"visible\":true}]")
  // One of the DESTAQUES_LAYOUT_VALUES in src/lib/homeSections.ts.
  destaquesLayout  String   @default("grid")
  // One of the OUTROS_LAYOUT_VALUES in src/lib/homeSections.ts.
  outrosLayout     String   @default("carrossel")
  // One of the ULTIMAS_LAYOUT_VALUES in src/lib/homeSections.ts.
  ultimasLayout    String   @default("grid")
  // Social links shown in the footer (src/components/SocialLinks.tsx). All
  // optional — a network with no URL set is simply omitted from the list.
  instagramUrl     String?
  facebookUrl      String?
  threadsUrl       String?
  twitterUrl       String?
  pinterestUrl     String?
  whatsappUrl      String?
  telegramUrl      String?
  updatedAt        DateTime @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  posts Post[]
}

model Post {
  id             String    @id @default(cuid())
  title          String
  slug           String    @unique
  excerpt        String
  content        String
  coverImageUrl  String?
  coverImageAlt  String?
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id])
  tags           Tag[]
  comments       Comment[]
  revisions      PostRevision[]
  viewsDaily     PostViewDaily[]
  views          Int       @default(0)
  published      Boolean   @default(false)
  publishedAt    DateTime?
  // Who created the post (see createPost in src/app/admin/(protected)/posts/actions.ts).
  // Nullable because posts created before this column existed have no author
  // on record, and because the account can later be deleted (onDelete: SetNull
  // keeps the post instead of cascading the deletion into it).
  authorId       String?
  author         AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// Day-bucketed view counter, separate from Post.views (a simple running
// total). Lets the admin analytics dashboard (src/app/admin/(protected)/analytics)
// chart real traffic over time without storing one row per page view.
model PostViewDaily {
  id     String   @id @default(cuid())
  postId String
  post   Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  // Truncated to the start of the UTC day (see src/lib/postViews.ts).
  date   DateTime
  count  Int      @default(0)

  @@unique([postId, date])
  @@index([date])
}

model Comment {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorName  String
  authorEmail String?
  body        String
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  // Who approved this comment (see approveComment in
  // src/app/admin/(protected)/comentarios/actions.ts). Nullable: unapproved
  // comments have no moderator yet, and the account can later be deleted.
  moderatedById String?
  moderatedBy   AdminUser? @relation(fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedAt   DateTime?
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// A named admin account (src/lib/adminUsers.ts). Replaces the single shared
// ADMIN_PASSWORD login: each person editing the blog gets their own
// login/password, which is safer and lets actions be attributed to a person.
// The very first row is bootstrapped from ADMIN_EMAIL/ADMIN_PASSWORD in .env
// (see bootstrapFirstAdminUser); every account created afterwards goes
// through /admin/usuarios.
model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  // "admin" or "editor" (see ADMIN_ROLES in src/lib/validation.ts). Admins can
  // manage other admin accounts and delete any post; editors can only delete
  // posts they authored themselves.
  role         String   @default("editor")
  createdAt    DateTime @default(now())
  posts             Post[]
  revisions         PostRevision[]
  moderatedComments Comment[]
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime
}

// A sponsored banner shown on the public site (see src/components/CampaignBanner.tsx).
// `active` plus the optional date window both gate visibility — see
// src/lib/campaigns.ts#getActiveCampaigns.
model Campaign {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  linkUrl   String
  ctaText   String?
  // One of the CAMPAIGN_PLACEMENT_VALUES in src/lib/homeSections.ts.
  placement String    @default("home_posts")
  active    Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  // Admin-only performance counters (see src/components/CampaignBanner.tsx and
  // src/app/go/[id]/route.ts) — never shown on the public site.
  views     Int       @default(0)
  clicks    Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PostRevision {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title     String
  excerpt   String
  content   String
  createdAt DateTime @default(now())
  // Who made the edit that produced this snapshot (see updatePost and
  // restorePostRevision in src/app/admin/(protected)/posts/actions.ts).
  // Nullable: the account can later be deleted.
  authorId  String?
  author    AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId])
  @@index([authorId])
}
